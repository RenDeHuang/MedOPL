{
  "schema_version": 1,
  "owner": "MedOPL Platform",
  "purpose": "medopl_product_authority_profile",
  "state": "active",
  "authority_boundary": {
    "model": "platform_provisioned_customer_dedicated_opl_saas",
    "authority": "product_contract_authority",
    "upstream_opl_role": "clean_research_runtime_reference",
    "change_package_role": "not_product_authority"
  },
  "consumers": [
    "validate:active-platform",
    "tests/contracts/contract-test-v22-validate-active-platform.mjs"
  ],
  "consumer_tests": [
    "npm run validate:active-platform -- --quick --json"
  ],
  "medopl_product_profile": {
    "primary_user_offer": [
      "compute_resource",
      "storage_space",
      "package_plan",
      "task_concurrency",
      "usage_billing",
      "resource_lifecycle",
      "opl_entry"
    ],
    "supporting_receipt_surface": {
      "audit": "billing_release_storage_lifecycle_receipt",
      "run_ref": "usage_and_billing_reference_only",
      "artifact_ref": "storage_inventory_reference_only"
    },
    "owner_split": {
      "medopl_owns": [
        "compute_resource_lifecycle",
        "storage_space_lifecycle",
        "package_plan_catalog",
        "usage_billing",
        "resource_release",
        "ops_audit_receipts"
      ],
      "opl_webui_owns": [
        "chat_first_project_session_surface",
        "file_management_experience",
        "skill_upload",
        "research_task_user_experience",
        "ordinary_chat"
      ],
      "opl_owns": [
        "framework_runtime_semantics",
        "agent_skill_protocol",
        "research_execution_runtime"
      ]
    },
    "user_surface_fixed_objects": [
      "resource_overview",
      "package_purchase",
      "compute_resource",
      "storage_space_inventory",
      "usage_billing",
      "opl_entry"
    ],
    "user_surface_forbidden_objects": [
      "chat",
      "project_session_surface",
      "skill_upload",
      "raw_trace",
      "raw_log",
      "cloud_console_fields",
      "secret_token_or_signed_url"
    ],
    "primary_consumer_surface": {
      "name": "opl-webui",
      "role": "entry_and_chat_surface",
      "ordinary_chat_owner": "opl-webui",
      "runtime_required_owner": "medopl",
      "integration_contract": "POST /api/opl/runtime-gate"
    },
    "platform_responsibilities": [
      "provision",
      "isolate",
      "operate_runtime",
      "manage_files",
      "meter_usage",
      "bill",
      "audit",
      "release"
    ],
    "non_responsibilities": [
      "opl_research_quality",
      "medical_judgment_quality",
      "grant_quality",
      "paper_quality"
    ],
    "forbidden_product_framing": [
      "user_owned_cloud_console",
      "resource_order_governance_repo",
      "upstream_opl_as_active_platform_source"
    ]
  }
}
