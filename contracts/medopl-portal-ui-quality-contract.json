{
  "schema_version": 1,
  "owner": "MedOPL Portal",
  "purpose": "portal_ui_quality_contract",
  "state": "active",
  "authority_boundary": {
    "surface": "customer_control_plane_visual_and_accessibility_floor",
    "allowed_view": "clean_resource_control_plane",
    "forbidden_view": "marketing_hero_card_wall_cloud_console_or_workbench"
  },
  "consumers": [
    "tests/frontend/frontend-test-v22-portal-page-state-matrix.mjs",
    "tests/regression/portal/regression-test-v22-portal-resource-control-ui-browser.mjs"
  ],
  "consumer_tests": [
    "npm run test:frontend",
    "npm run test:regression"
  ],
  "medopl_portal_ui_quality_contract": {
    "touch_target": {
      "min_px": 44,
      "applies_to": [
        "nav_link",
        "nav_button",
        "header_action",
        "primary_action",
        "logo_link",
        "tabs_trigger",
        "input",
        "switch"
      ]
    },
    "brand": {
      "primary_hex": "#0F766E",
      "primary_name": "Teal",
      "forbidden_primary_hues": [
        "default_technology_blue",
        "default_technology_purple"
      ]
    },
    "motion": {
      "transition_all_allowed": false,
      "duration_ms_max": 180,
      "reduced_motion_respected": true,
      "allowed_transition_properties": [
        "colors",
        "background-color",
        "border-color",
        "box-shadow",
        "transform",
        "opacity"
      ]
    },
    "interaction_states": {
      "required": [
        "hover",
        "active",
        "focus-visible",
        "disabled",
        "cursor"
      ]
    },
    "copy": {
      "language": "zh-CN_resource_control_plane",
      "forbidden_visible_terms": [
        "workspace",
        "Runtime",
        "not_activated",
        "funded",
        "MedOPL plan catalog",
        "mutation",
        "runner phase",
        "claim",
        "future-authorized",
        "ops_surface_disabled"
      ],
      "preferred_terms": {
        "workspace": "工作空间",
        "Runtime": "计算环境",
        "not_activated": "待开通",
        "funded": "已入账",
        "MedOPL plan catalog": "套餐目录",
        "mutation": "能力接入",
        "runner phase": "平台接入阶段",
        "claim": "声明",
        "future-authorized": "待授权",
        "ops_surface_disabled": "运维入口未启用"
      }
    },
    "card": {
      "radius_max_px": 8,
      "no_card_inside_card": true,
      "first_view_card_budget_default": {
        "core_resource_cards": 3,
        "extra_kpi_cards": 0
      }
    },
    "semantic_heading": {
      "required_h1_owner": "page_content",
      "logo_h1_allowed": false,
      "unique_content_h1": true
    },
    "billing": {
      "first_view_layout": "billing_summary_status_band_then_ledger_details",
      "first_view_extra_kpi_cards_max": 0,
      "summary_component_count": 1,
      "status_band_count": 1
    },
    "accessibility": {
      "visible_focus_state_required": true,
      "disabled_reason_required": true,
      "no_horizontal_overflow": true,
      "dangerous_action_confirmation_required": true,
      "reduced_motion_respected": true,
      "color_not_sole_status_signal": true,
      "status_feedback_requires_aria_label": true,
      "status_feedback_requires_visible_label": true,
      "status_feedback_requires_icon": true
    },
    "production_readiness": {
      "claim_requires_runtime_receipt": true,
      "cannot_claim_from": [
        "ui_green",
        "contract_green",
        "local_browser_screenshot",
        "local_rc"
      ],
      "required_gates": [
        "staging_or_prod_like_canary",
        "role_boundary_browser_gate",
        "release_owner_receipt",
        "security_dependency_gate",
        "observability_receipt",
        "s_level_ui_polish_gate"
      ],
      "security_dependency_gate": {
        "command": "npm --prefix services/portal/frontend audit --omit=dev --audit-level=high --json",
        "consumer": "scripts/v22-repo-hygiene.mjs",
        "max_prod_high_vulnerabilities": 0
      },
      "root_production_dependency_gate": {
        "command": "npm audit --omit=dev --audit-level=high --json",
        "consumer": "scripts/v22-repo-hygiene.mjs",
        "max_prod_high_or_critical_vulnerabilities": 0,
        "authorized_cloud_sdk_scope": "dev_dependency_tooling_only"
      },
      "accessibility_verification": {
        "consumer": "tests/regression/portal/regression-test-v22-portal-resource-control-ui-browser.mjs",
        "checks": [
          "keyboard_focus_visible",
          "touch_targets_44px",
          "heading_hierarchy",
          "role_boundary_mobile_nav",
          "labelled_navigation_landmark",
          "no_horizontal_overflow",
          "disabled_reason_visible",
          "status_feedback_non_color_signal",
          "all_customer_pages_browser_covered"
        ]
      },
      "observability_receipt": {
        "required_before_production_claim": true,
        "receipt_type": "production_deploy_receipt",
        "receipt_manifest": "contracts/medopl-production-receipt-boundary.json"
      },
      "release_owner_readiness": {
        "receipt_type": "release_owner_receipt",
        "current_ui_state": "partial_fail_closed_pending_release_mutation",
        "ui_state_marker": "partial_fail_closed_pending_owner_receipt",
        "claimable_before_owner_receipt": false
      },
      "s_level_ui_polish_gate": {
        "consumer": "tests/regression/portal/regression-test-v22-portal-resource-control-ui-browser.mjs",
        "checks": [
          "component_state_consistency",
          "status_feedback",
          "status_feedback_non_color_signal",
          "responsive_data_tables",
          "admin_template_hierarchy",
          "empty_error_recovery"
        ]
      }
    },
    "a_plus_s_floor": {
      "freeze_scope": "principles_not_pixels",
      "required": [
        "component_state_consistency",
        "status_feedback",
        "status_feedback_non_color_signal",
        "responsive_data_tables",
        "admin_template_hierarchy",
        "empty_error_recovery"
      ]
    },
    "style": {
      "tone": "clean_restrained_resource_control_plane",
      "no_marketing_hero": true,
      "no_gradient_orb_background": true,
      "no_dark_admin_sidebar_for_customer": true
    }
  }
}
