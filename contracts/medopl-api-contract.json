          "owner": "medopl",
          "entry": "runtime_required specialist task after MedOPL approval credit plan runtime storage",
          "state": "ready",
          "medopl_runtime_required": true,
          "medopl_storage_required": true,
          "ready_source_owner": "medopl",
          "allowed_webui_bridge_actions": ["POST /api/opl/runtime-gate", "POST /api/opl/runs"],
          "projection_policy": "refs_progress_deliverables_only",
          "cannot_claim": [
            "runtime_execution_completed",
            "artifact_body_authority",
            "storage_truth_ownership",
            "domain_verdict_authority"
          ]
        }
      ],
      "can_claim": [
