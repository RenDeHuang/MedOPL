{
  "schema_version": 1,
  "owner": "MedOPL API",
  "purpose": "customer_control_plane_api_contract",
  "state": "active",
  "authority_boundary": {
    "surface": "portal_to_platform_api",
    "auth_boundary": "backend_session_and_provider_key_ref_only",
    "raw_secret_location": "backend_secret_boundary_only"
  },
  "consumers": [
    "validate:active-platform",
    "tests/backend/backend-test-v22-api-contract.mjs",
    "tests/contracts/contract-test-v22-go-backend-service-surface.mjs",
    "tests/contracts/contract-test-v22-validate-active-platform.mjs"
  ],
  "consumer_tests": [
    "npm run test:backend",
    "node tests/contracts/contract-test-v22-go-backend-service-surface.mjs",
    "npm run validate:active-platform -- --quick --json"
  ],
  "medopl_api_contract": {
    "api_groups": [
      "account",
      "workspace",
      "runtime",
      "files",
      "billing",
      "audit",
      "release"
    ],
    "resource_identity": [
      "tenant_id",
      "workspace_id",
      "runtime_id",
      "session_id",
      "run_id",
      "file_id",
      "ledger_entry_id"
    ],
    "must_return": [
      "state",
      "owner",
      "created_at",
      "updated_at"
    ],
    "must_fail_closed_on": [
      "missing_tenant",
      "unknown_workspace",
      "raw_provider_key",
      "unscoped_file_ref",
      "ledger_mismatch"
    ],
    "forbidden_response_fields": [
      "raw_provider_key",
      "bearer_token",
      "runtime_token",
      "launch_token",
      "kubeconfig_content"
    ],
    "account_productization": {
      "intent": "owner_created_or_approved_account_recharge_plan_productization",
      "routes": [
        "POST /api/v22/users/prepare",
        "POST /api/v22/users/approve",
        "POST /api/v22/users/credit",
        "POST /api/v22/billing/payment-orders",
        "POST /api/v22/billing/payment-paid",
        "GET /api/v22/billing/statement",
        "GET /api/v22/runtime/freeze"
      ],
      "approval_policy": "prepared_account_is_not_approved_until_owner_approve",
      "commercial_runtime_fail_closed_on": [
        "account_required",
        "account_not_approved",
        "insufficient_balance"
      ],
      "productized_fields": [
        "status",
        "balance",
        "activeFreeze",
        "availableBalance",
        "currentPackageId",
        "purchaseProjection",
        "canOpenRuntimeStorage"
      ],
      "cost_ceiling_source": "business_account_balance_plan_hold_amount_and_quota",
      "can_claim": [
        "repo_local_account_recharge_plan_productization",
        "owner_created_or_approved_paid_account_runtime_gate",
        "insufficient_balance_fail_closed"
      ],
      "cannot_claim": [
        "external_psp_settlement",
        "cloud_deployment_proof",
        "full_production_complete"
      ]
    },
    "payment_admin_api_maturity": {
      "intent": "payment_admin_api_maturity_boundary_without_external_psp_settlement_claim",
      "current_truth": [
        "internal_credit_billing_ledger_statement_reconciliation_release_destroy_stop_billing_passed",
        "external_psp_settlement_not_completed",
        "real_payment_refund_invoice_tax_compliance_not_completed"
      ],
      "required_surfaces": [
        "payment_order",
        "payment_intent",
        "payment_provider_config",
        "psp_webhook_intake",
        "settlement_event",
        "refund_event",
        "invoice_metadata",
        "payment_reconciliation",
        "admin_payment_operation_audit"
      ],
      "routes": [
        "POST /api/v22/billing/payment-orders",
        "POST /api/v22/billing/payment-paid",
        "POST /api/v22/billing/refund",
        "POST /api/v22/billing/adjustment",
        "GET /api/v22/billing/statement"
      ],
      "payment_ledger": {
        "owner": "future_payment_provider_settlement_boundary",
        "responsibilities": [
          "payment_intent",
          "provider_verified_payment",
          "settlement_event",
          "refund_event",
          "invoice_metadata",
          "payment_reconciliation_refs"
        ],
        "state": "contract_boundary_only_not_connected_to_external_psp"
      },
      "billing_ledger": {
        "owner": "medopl_resource_usage_billing_boundary",
        "responsibilities": [
          "account_balance",
          "credit",
          "hold",
          "debit",
          "release",
          "usage",
          "statement",
          "release_destroy_stop_billing"
        ],
        "state": "active_internal_credit_and_resource_usage_ledger"
      },
      "reconciliation_refs": [
        "account_id",
        "workspace_id",
        "statement_id",
        "payment_order_id",
        "provider_event_ref",
        "ledger_event_id"
      ],
      "admin_operation_audit": {
        "required": true,
        "event_kinds": [
          "payment_order_created",
          "admin_credit_recorded",
          "payment_mark_paid_recorded",
          "refund_recorded",
          "adjustment_recorded",
          "payment_reconciliation_recorded"
        ],
        "boundary": "admin_operation_audit_records_operator_action_without_claiming_provider_settlement"
      },
      "mock_payment_policy": "mock_or_admin_credit_must_not_claim_real_payment",
      "secret_boundary": "provider_secret_refs_only_no_raw_secret_in_contract_or_ui",
      "forbidden_response_fields": [
        "cardNumber",
        "bankAccount",
        "paymentProviderSecret",
        "rawProviderWebhookSecret"
      ],
      "can_claim": [
        "payment_admin_api_maturity_contract",
        "internal_admin_credit_mode_explicit",
        "payment_vs_billing_ledger_boundary"
      ],
      "cannot_claim": [
        "external_psp_settlement",
        "real_payment_completed",
        "refund_completed_against_external_provider",
        "invoice_tax_compliance_complete",
        "tax_compliance_complete"
      ],
      "implementation_roadmap": [
        "payment contract",
        "admin payment UI/API",
        "PSP adapter",
        "webhook verification",
        "reconciliation",
        "refund/invoice",
        "docs"
      ]
    },
    "runtime_gate": {
      "route": "POST /api/opl/runtime-gate",
      "product_owner": "medopl",
      "primary_consumer": "opl-webui",
      "consumer_role": "entry_and_chat_surface",
      "ordinary_chat_owner": "opl-webui",
      "runtime_required_owner": "medopl",
      "invocation_modes": [
        "api_only",
        "ordinary_chat",
        "runtime_required"
      ],
      "must_return": [
        "productOwner",
        "primaryConsumer",
        "consumerRole",
        "workspaceBindingId",
        "invocationMode",
        "medoplRuntimeRequired",
        "providerKeyStatus",
        "providerKeyRef",
        "runtimeBindingId",
        "runtimeState",
        "storageBindingId",
        "storageState",
        "nodePoolProjection",
        "billing",
        "release",
        "consumerProjection",
        "commercialAdmission",
        "actionContract",
        "nextAction"
      ],
      "commercial_admission": {
        "intent": "account_approved_commercial_runtime_gate",
        "conditions": [
          "account_exists",
          "account_approved",
          "workspace_exists",
          "provider_key_ref_exists_when_needed",
          "plan_selected",
          "balance_sufficient",
          "quota_available",
          "no_emergency_platform_stop"
        ],
        "decision_fields": [
          "accountExists",
          "accountApproved",
          "workspaceExists",
          "providerKeyRefExists",
          "planSelected",
          "balanceSufficient",
          "quotaAvailable",
          "emergencyPlatformStop",
          "allowed",
          "decision",
          "reason"
        ],
        "blocking_actions": [
          "open_medopl_purchase",
          "select_plan",
          "recharge_or_credit_required",
          "open_runtime_storage"
        ],
        "boundary": "paid_account_runtime_gate_uses_account_plan_balance_quota_and_platform_stop_state"
      },
      "commercial_action_contract": {
        "intent": "opl_webui_runtime_required_commercial_purchase_actions",
        "actions": [
          "open_medopl_purchase",
          "select_plan",
          "recharge_or_credit_required",
          "open_runtime_storage",
          "return_to_opl_task"
        ],
        "action_fields": [
          "action",
          "reason",
          "workspaceId",
          "sessionId",
          "taskRef",
          "taskIntent",
          "requiredPlan",
          "planRequirement",
          "balanceRequirement",
          "medoplDeeplink",
          "returnToOplDeeplink",
          "returnToOplTaskContract",
          "canClaim",
          "cannotClaim"
        ],
        "purchase_action_projection": {
          "intent": "medopl_purchase_plan_recharge_open_resource_projection",
          "actions": [
            "select_plan",
            "recharge_or_credit_required",
            "open_runtime_storage",
            "return_to_opl_task"
          ],
          "fields": [
            "workspaceId",
            "sessionId",
            "taskRef",
            "taskIntent",
            "requiredPlan",
            "selectedPlanId",
            "balance",
            "availableBalance",
            "activeFreeze",
            "minRequiredBalance",
            "canOpenRuntimeStorage",
            "selectPlanAction",
            "rechargeOrCreditAction",
            "openRuntimeStorageAction",
            "returnToOplAction",
            "returnToOplTaskContract",
            "canClaim",
            "cannotClaim"
          ],
          "boundary": "purchase_projection_uses_internal_credit_and_existing_resource_opening_only"
        },
        "return_to_opl_task_contract": {
          "intent": "stable_deeplink_and_session_resume_contract_for_opl_webui",
          "fields": [
            "resumeAction",
            "resumeMethod",
            "workspaceId",
            "sessionId",
            "taskRef",
            "taskIntent",
            "returnToOplDeeplink",
            "requiredConsumer",
            "canClaim",
            "cannotClaim"
          ],
          "can_claim": [
            "return_to_opl_task_contract"
          ],
          "cannot_claim": [
            "full_opl_webui_resume_implementation",
            "opl_domain_quality_verdict"
          ]
        },
        "boundary": "machine_readable_action_contract_only",
        "does_not_claim": [
          "external_psp_settlement",
          "complete_purchase_page",
          "full_opl_webui_resume_implementation",
          "cloud_deployment_proof",
          "opl_domain_quality_verdict"
        ]
      },
      "operations_safety_boundary": {
        "intent": "production_launch_operations_safety_gate_only",
        "operator_confirmation_gate": "workflow_dispatch_plus_github_production_environment_deployment_operations_safety",
        "workflow_input_refs": [
          "confirm_production_launch",
          "rollout_scope",
          "launch_scope",
          "emergency_stop",
          "cost_guard_ref",
          "owner",
          "rollback_ref"
