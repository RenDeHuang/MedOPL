        "receipt_ref": ".runtime/v22-cloud-authorization/run-v22-001/production-launch-operator-confirmation-receipt.json",
        "retained_because": "active_production_launch_workflow_records_one_person_operator_confirmation_from_workflow_dispatch_inputs_and_github_production_environment",
        "cannot_claim": [
          "business_or_commercial_admission_truth",
          "recharge_or_billing_rule",
          "paid_account_runtime_gate",
          "non_commercial_business_admission",
          "external_psp_settlement"
        ],
        "must_not_return": [
          "canaryAdmission",
          "tenantAllowlist",
          "userAllowlist",
          "rawTenantId",
          "rawUserId",
          "rawProviderKey",
          "bearerToken",
          "runtimeToken",
          "kubeconfig"
        ]
      },
      "forbidden_response_fields": [
        "rawProviderKey",
        "apiKey",
        "providerApiKey",
        "bearerToken",
        "launchToken",
        "runtimeToken",
        "kubeconfig"
      ],
      "must_not_claim": [
        "medopl_owns_ordinary_chat",
        "medopl_owns_opl_research_quality",
        "runtime_required_without_medopl_runtime",
        "storage_destroy_without_user_intent"
