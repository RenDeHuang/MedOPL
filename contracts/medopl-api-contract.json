{
  "schema_version": 1,
  "owner": "MedOPL API",
  "purpose": "customer_control_plane_api_contract",
  "state": "active",
  "authority_boundary": {
    "surface": "portal_to_platform_api",
    "auth_boundary": "backend_session_and_provider_key_ref_only",
    "raw_secret_location": "backend_secret_boundary_only"
  },
  "consumers": [
    "validate:active-platform",
    "tests/backend/backend-test-v22-api-contract.mjs",
    "tests/contracts/contract-test-v22-go-backend-service-surface.mjs",
    "tests/contracts/contract-test-v22-validate-active-platform.mjs"
  ],
  "consumer_tests": [
    "npm run test:backend",
    "node tests/contracts/contract-test-v22-go-backend-service-surface.mjs",
    "npm run validate:active-platform -- --quick --json"
  ],
  "medopl_api_contract": {
    "api_groups": [
      "account",
      "workspace",
      "runtime",
      "files",
      "billing",
      "audit",
      "release"
    ],
    "resource_identity": [
      "tenant_id",
      "workspace_id",
      "runtime_id",
      "session_id",
      "run_id",
      "file_id",
      "ledger_entry_id"
    ],
    "must_return": [
      "state",
      "owner",
      "created_at",
      "updated_at"
    ],
    "must_fail_closed_on": [
      "missing_tenant",
      "unknown_workspace",
      "raw_provider_key",
      "unscoped_file_ref",
      "ledger_mismatch"
    ],
    "forbidden_response_fields": [
      "raw_provider_key",
      "bearer_token",
      "runtime_token",
      "launch_token",
      "kubeconfig_content"
    ],
    "runtime_gate": {
      "route": "POST /api/opl/runtime-gate",
      "product_owner": "medopl",
      "primary_consumer": "opl-webui",
      "consumer_role": "entry_and_chat_surface",
      "ordinary_chat_owner": "opl-webui",
      "runtime_required_owner": "medopl",
      "invocation_modes": [
        "api_only",
        "ordinary_chat",
        "runtime_required"
      ],
      "must_return": [
        "productOwner",
        "primaryConsumer",
        "consumerRole",
        "workspaceBindingId",
        "invocationMode",
        "medoplRuntimeRequired",
        "providerKeyStatus",
        "providerKeyRef",
        "runtimeBindingId",
        "runtimeState",
        "storageBindingId",
        "storageState",
        "nodePoolProjection",
        "billing",
        "release",
        "consumerProjection",
        "nextAction"
      ],
      "forbidden_response_fields": [
        "rawProviderKey",
        "apiKey",
        "providerApiKey",
        "bearerToken",
        "launchToken",
        "runtimeToken",
        "kubeconfig"
      ],
      "must_not_claim": [
        "medopl_owns_ordinary_chat",
        "medopl_owns_opl_research_quality",
        "runtime_required_without_medopl_runtime",
        "storage_destroy_without_user_intent"
      ]
    },
    "run_result": {
      "route": "POST /api/opl/runs",
      "owner": "medopl",
      "primary_consumer": "opl-webui",
      "intent": "runtime_required_task_run_result_for_consumer_canary",
      "must_return": [
        "ok",
        "status",
        "statusUrl",
        "run",
        "artifactRef",
        "artifacts"
      ],
      "artifact_ref_policy": "top_level_artifactRef_must_match_first_artifact_artifactRef",
      "must_not_return": [
        "rawObjectStoreSecret",
        "signedUrl",
        "objectKey",
        "storageKey",
        "localPath",
        "bearerToken",
        "runtimeToken",
        "kubeconfig"
      ]
    },
    "billing_summary": {
      "route": "GET /api/billing/summary",
      "owner": "medopl",
      "primary_consumer": "opl-webui",
      "intent": "runtime_required_billing_summary_for_consumer_canary",
      "must_return": [
        "ok",
        "source",
        "runCount",
        "ledgerCount",
        "summary",
        "ledger"
      ],
      "count_policy": "top_level_runCount_and_ledgerCount_must_match_summary_runCount_and_ledger_length",
      "must_not_return": [
        "rawObjectStoreSecret",
        "signedUrl",
        "objectKey",
        "storageKey",
        "localPath",
        "bearerToken",
        "runtimeToken",
        "kubeconfig"
      ]
    },
    "storage_destroy": {
      "route": "POST /api/v22/storage/destroy",
      "owner": "medopl",
      "primary_consumer": "opl-webui",
      "intent": "explicit_user_storage_destroy",
      "must_return": [
        "ok",
        "storageDestroyed",
        "billingStopped",
        "storageBindingId",
        "storageState",
        "auditEvent",
        "releaseReceipts"
      ],
      "must_not_return": [
        "rawObjectStoreSecret",
        "signedUrl",
        "objectKey",
        "storageKey",
        "localPath",
        "bearerToken",
        "runtimeToken",
        "kubeconfig"
      ]
    }
  }
}
