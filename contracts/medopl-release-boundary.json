{
  "schema_version": 1,
  "owner": "MedOPL Release",
  "purpose": "workspace_release_boundary_contract",
  "state": "active",
  "authority_boundary": {
    "surface": "customer_workspace_release_and_cleanup",
    "default_real_cloud_mutation": "allowed_when_authorization_pack_is_active",
    "authorization_pack": "contracts/medopl-cloud-authorization-pack.json",
    "production_receipt_boundary": "contracts/medopl-production-receipt-boundary.json",
    "release_claim_requires": "local_gate_and_release_owner_receipt"
  },
  "consumers": [
    "validate:active-platform",
    "scripts/v22-production-receipt-boundary.mjs",
    "tests/contracts/contract-test-v22-precloud-deployable-rc.mjs",
    "tests/release/release-test-v22-boundary-contract.mjs",
    "tests/release/release-test-v22-production-receipt-boundary.mjs"
  ],
  "consumer_tests": [
    "node tests/contracts/contract-test-v22-precloud-deployable-rc.mjs",
    "node tests/release/release-test-v22-boundary-contract.mjs",
    "node tests/release/release-test-v22-production-receipt-boundary.mjs"
  ],
  "medopl_release_boundary": {
    "release_phases": [
      "request",
      "freeze_runtime",
      "settle_billing",
      "export_files",
      "destroy_storage_intent",
      "cleanup_resources",
      "write_receipt"
    ],
    "required_receipts": [
      "runtime_stopped",
      "file_export_status",
      "billing_settlement",
      "audit_export_ref",
      "resource_cleanup_ref",
      "storage_destroy_receipt"
    ],
    "storage_destroy_policy": {
      "runtime_release_default": "retain_storage_until_explicit_user_intent",
      "destroy_requires": "explicit_user_storage_destroy_intent",
      "receipt_owner": "MedOPL Data Plane"
    },
    "medopl_deploy_install_package_maturity": {
      "current_mode": "local_standalone_package_boundary_no_cloud_execution",
      "required_surfaces": [
        "deploy_package",
        "env_config_example",
        "compose_local",
        "compose_standalone",
        "install",
        "upgrade",
        "uninstall",
        "systemd_service_example",
        "secret_generation",
        "admin_bootstrap",
        "setup_wizard_future_boundary"
      ],
      "distribution_entrypoints": [
        "compose.product.yaml",
        ".env.demo.template",
        "docs/delivery/README.md"
      ],
      "compose_profiles": [
        "product",
        "dev",
        "standalone"
      ],
      "lifecycle_actions": [
        "install",
        "upgrade",
        "uninstall"
      ],
      "secret_generation_policy": {
        "tracked_templates": "empty_secret_values_only",
        "runtime_secret_output": ".runtime or operator secret store only",
        "raw_secret_in_git": "forbidden"
      },
      "admin_bootstrap_policy": {
        "mode": "owner_admin_bootstrap_required",
        "default_real_payment": "not_completed",
        "account_truth": "owner-created-or-approved MedOPL account with sufficient plan/balance/quota"
      },
      "setup_wizard_future_boundary": {
        "state": "future_goal",
        "next_goal": "goal-commercial-owner-bootstrap-setup-wizard",
        "cannot_claim_now": [
          "self-serve setup complete",
          "automatic production setup complete"
        ]
      },
      "must_not_touch": [
        "deploy/medopl-cloud/medopl.k8s.json",
        ".github/workflows/cloud-rollout.yml",
        "contracts/medopl-cloud-authorization-pack.json"
      ],
      "cannot_claim": [
        "cloud deploy executed",
        "build/push executed",
        "live-test executed",
        "production complete",
        "external PSP settlement",
        "systemd service installed on host"
      ]
    },
    "medopl_owner_bootstrap_setup_wizard_maturity": {
      "current_mode": "local_first_run_setup_boundary_no_secret_read_no_cloud",
      "required_surfaces": [
        "owner_admin_initial_account_bootstrap",
        "admin_password_secret_generation_boundary",
        "first_run_setup_flow",
        "config_validation",
        "setup_completed_marker",
        "install_package_setup_handoff"
      ],
      "install_package_setup_handoff": {
        "from": "compose.product.yaml#x-medopl-package-maturity",
        "to": "compose.product.yaml#x-medopl-setup-wizard-maturity",
        "mode": "operator_local_or_standalone_first_run"
      },
      "owner_admin_initial_account_bootstrap": {
        "account_truth": "owner-created-or-approved MedOPL account with sufficient plan/balance/quota",
        "bootstrap_action": "create_or_approve_owner_admin_account",
        "must_not_replace": [
          "POST /api/v22/users/prepare",
          "POST /api/v22/users/approve",
          "POST /api/v22/users/credit"
        ]
      },
      "secret_policy": {
        "raw_secret_read": "forbidden",
        "tracked_templates": "empty_secret_values_only",
        "generated_secret_output": ".runtime or operator secret store only",
        "browser_storage": "forbidden"
      },
      "config_validation": {
        "fail_closed": true,
        "required_refs": [
          "PORTAL_ADMIN_EMAIL",
          "PORTAL_ADMIN_PASSWORD",
          "MEDOPL_SETUP_COMPLETED",
          "MEDOPL_SETUP_MARKER_PATH"
        ]
      },
      "setup_completed_marker": {
        "state": "required_after_owner_admin_bootstrap",
        "location": "operator env file or backend setup state only",
        "raw_secret_policy": "marker_must_not_contain_secret"
      },
      "must_not_claim": [
        "cloud deploy executed",
        "build/push executed",
        "live-test executed",
        "real secret generated or read",
        "external PSP settlement",
        "self-serve setup wizard complete",
        "production complete"
      ]
    },
    "release_owner_readiness": {
      "receipt_type": "release_owner_receipt",
      "production_criterion": "release_owner_readiness_receipt",
      "required_gate": "release_owner_receipt",
      "evidence_ref_policy": "runtime_pointer_summary_only",
      "evidence_hash_policy": "sha256_pointer_hash_required",
      "raw_evidence_policy": "forbidden",
      "current_ui_state": "partial_fail_closed_pending_release_mutation",
      "claimable_before_owner_receipt": false
    },
    "must_not_claim_without": [
      "runtime_stop_receipt",
      "billing_settlement_receipt",
      "cleanup_receipt",
      "audit_receipt"
    ],
    "legacy_source_references": [
      "contracts/cloud-deploy-readiness-contract.json"
    ]
  }
}
