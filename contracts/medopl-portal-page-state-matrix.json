{
  "schema_version": 2,
  "owner": "MedOPL Portal",
  "purpose": "portal_product_page_state_matrix",
  "state": "active",
  "authority_boundary": {
    "surface": "customer_control_plane",
    "allowed_view": "resource_purchase_and_compute_resource_management",
    "forbidden_view": "chat_workbench_raw_trace_or_cloud_console"
  },
  "consumers": [
    "validate:active-platform",
    "tests/contracts/contract-test-v22-validate-active-platform.mjs",
    "tests/frontend/frontend-test-v22-portal-page-state-matrix.mjs"
  ],
  "consumer_tests": [
    "npm run validate:active-platform -- --quick --json",
    "npm run test:frontend"
  ],
  "medopl_portal_page_state_matrix": {
    "global_states": [
      "empty",
      "provisioning",
      "active",
      "degraded",
      "suspended",
      "releasing",
      "released"
    ],
    "pages": [
      {
        "id": "resource_overview",
        "owns": [
          "current_package",
          "compute_resource_status",
          "storage_space_status",
          "balance",
          "next_resource_action"
        ],
        "states": [
          "empty",
          "provisioning",
          "active",
          "suspended",
          "released"
        ],
        "required_h1_owner": "page_content",
        "mobile_touch_target_min_px": 44,
        "first_view_card_budget": {
          "core_resource_cards": 3,
          "extra_kpi_cards": 0
        }
      },
      {
        "id": "packages_purchase",
        "owns": [
          "package_plan",
          "compute_spec",
          "included_storage",
          "task_concurrency",
          "price_label",
          "purchase_action"
        ],
        "states": [
          "catalog_ready",
          "pending_price_approval",
          "purchase_blocked",
          "upgrade_available"
        ],
        "required_h1_owner": "page_content",
        "mobile_touch_target_min_px": 44,
        "first_view_card_budget": {
          "core_resource_cards": 2,
          "extra_kpi_cards": 0
        }
      },
      {
        "id": "compute_resource",
        "owns": [
          "compute_status",
          "compute_spec",
          "task_concurrency",
          "workspace_binding",
          "release_state",
          "stop_billing_state"
        ],
        "states": [
          "not_opened",
          "opening",
          "idle",
          "running",
          "failed",
          "releasing",
          "released"
        ],
        "required_h1_owner": "page_content",
        "mobile_touch_target_min_px": 44,
        "first_view_card_budget": {
          "core_resource_cards": 3,
          "extra_kpi_cards": 0
        }
      },
      {
        "id": "storage_space",
        "owns": [
          "capacity",
          "used_space",
          "workspace_binding",
          "input_file_inventory",
          "output_file_inventory",
          "retention",
          "protection_period"
        ],
        "states": [
          "empty",
          "ready",
          "quota_limited",
          "protected",
          "destroy_pending",
          "destroyed"
        ],
        "required_h1_owner": "page_content",
        "mobile_touch_target_min_px": 44,
        "first_view_card_budget": {
          "core_resource_cards": 3,
          "extra_kpi_cards": 0
        }
      },
      {
        "id": "usage_billing",
        "owns": [
          "balance",
          "freeze",
          "compute_usage",
          "storage_usage",
          "ledger",
          "invoices",
          "stop_billing_reconciliation",
          "audit_receipt"
        ],
        "states": [
          "trial",
          "funds_confirmed",
          "past_due",
          "frozen"
        ],
        "required_h1_owner": "page_content",
        "mobile_touch_target_min_px": 44,
        "first_view_card_budget": {
          "core_resource_cards": 1,
          "extra_kpi_cards": 0
        },
        "first_view_layout": "billing_summary_status_band_then_ledger_details"
      },
      {
        "id": "opl_entry",
        "owns": [
          "opl_entry_state",
          "compute_resource_gate",
          "storage_binding_gate",
          "provider_key_gate",
          "missing_next_step"
        ],
        "states": [
          "available",
          "blocked_by_compute",
          "blocked_by_storage",
          "blocked_by_provider_key",
          "blocked_by_balance"
        ],
        "required_h1_owner": "page_content",
        "mobile_touch_target_min_px": 44,
        "first_view_card_budget": {
          "core_resource_cards": 1,
          "extra_kpi_cards": 0
        }
      },
      {
        "id": "release",
        "owns": [
          "release_request",
          "resource_cleanup",
          "final_receipt"
        ],
        "states": [
          "eligible",
          "pending",
          "completed",
          "blocked"
        ],
        "required_h1_owner": "page_content",
        "mobile_touch_target_min_px": 44,
        "first_view_card_budget": {
          "core_resource_cards": 1,
          "extra_kpi_cards": 0
        }
      }
    ],
    "ui_grammar": {
      "truth_gate": "MedOPL 是资源购买与计算资源管理 Portal；不是 chat、科研工作台、云控制台或 Trace 控制台。",
      "allowed_user_objects": [
        "compute_resource",
        "storage_space",
        "package_plan",
        "usage_billing",
        "resource_lifecycle",
        "opl_entry"
      ],
      "forbidden_user_objects": [
        "chat",
        "project_session_surface",
        "skill_upload",
        "raw_trace",
        "raw_log",
        "cloud_console_fields",
        "secret_token_or_signed_url"
      ],
      "user_task_flow": [
        "purchase_resource",
        "open_compute_resource",
        "inspect_storage_space",
        "review_usage_billing",
        "upgrade_or_expand",
        "release_compute_resource",
        "confirm_stop_billing",
        "enter_opl"
      ],
      "user_information_architecture": [
        "resource_overview",
        "packages_purchase",
        "compute_resource",
        "storage_space",
        "usage_billing",
        "opl_entry"
      ],
      "ops_information_architecture": [
        "provisioning_queue",
        "user_accounts",
        "resource_operations",
        "storage_operations",
        "billing_reconciliation",
        "audit",
        "system_status",
        "plan_catalog"
      ],
      "visual_grammar": {
        "customer_pages_max_width": "1120px_to_1200px",
        "customer_pages_primary_cta_limit": "one_per_view",
        "customer_pages_card_count_limit": "three_core_resource_cards_on_first_view",
        "tables_only_for_comparable_sets": "true",
        "ops_pages_queue_first": "true",
        "no_dark_admin_sidebar_for_customer": "true",
        "no_marketing_hero_for_customer": "true",
        "mobile_horizontal_overflow_allowed": "false",
        "billing_first_view_layout": "billing_summary_status_band_then_ledger_details",
        "billing_first_view_extra_kpi_cards_max": 0,
        "required_h1_owner": "page_content",
        "logo_heading_allowed": false,
        "mobile_touch_target_min_px": 44,
        "card_radius_max_px": 8,
        "brand_primary_hex": "#0F766E",
        "forbidden_primary_hues": [
          "default_technology_blue",
          "default_technology_purple"
        ],
        "transition_all_allowed": false,
        "allowed_motion_properties": [
          "colors",
          "background-color",
          "border-color",
          "box-shadow",
          "transform",
          "opacity"
        ],
        "forbidden_visible_internal_terms": [
          "workspace",
          "Runtime",
          "not_activated",
          "funded",
          "MedOPL plan catalog",
          "mutation",
          "runner phase",
          "claim",
          "future-authorized",
          "ops_surface_disabled"
        ]
      },
      "production_readiness": {
        "claim_requires_runtime_receipt": true,
        "release_partial_state_blocks_production_claim": true,
        "freeze_scope": "principles_not_pixels",
        "required_gates": [
          "staging_or_prod_like_canary",
          "role_boundary_browser_gate",
          "release_owner_receipt",
          "security_dependency_gate",
          "observability_receipt",
          "s_level_ui_polish_gate"
        ],
        "security_dependency_gate": {
          "command": "npm --prefix services/portal/frontend audit --omit=dev --audit-level=high --json",
          "consumer": "scripts/v22-repo-hygiene.mjs",
          "max_prod_high_vulnerabilities": 0
        },
        "root_production_dependency_gate": {
          "command": "npm audit --omit=dev --audit-level=high --json",
          "consumer": "scripts/v22-repo-hygiene.mjs",
          "max_prod_high_or_critical_vulnerabilities": 0,
          "authorized_cloud_sdk_scope": "dev_dependency_tooling_only"
        },
        "accessibility_verification": {
          "consumer": "tests/regression/portal/regression-test-v22-portal-resource-control-ui-browser.mjs",
          "checks": [
            "keyboard_focus_visible",
            "touch_targets_44px",
            "heading_hierarchy",
            "role_boundary_mobile_nav",
            "labelled_navigation_landmark",
            "no_horizontal_overflow",
            "disabled_reason_visible"
          ]
        },
        "observability_receipt": {
          "required_before_production_claim": true,
          "receipt_type": "production_deploy_receipt",
          "receipt_manifest": "contracts/medopl-production-receipt-boundary.json"
        },
        "release_owner_readiness": {
          "receipt_type": "release_owner_receipt",
          "current_ui_state": "partial_fail_closed_pending_release_mutation",
          "ui_state_marker": "partial_fail_closed_pending_owner_receipt",
          "claimable_before_owner_receipt": false
        },
        "s_level_ui_polish_gate": {
          "consumer": "tests/regression/portal/regression-test-v22-portal-resource-control-ui-browser.mjs",
          "checks": [
            "component_state_consistency",
            "status_feedback",
            "responsive_data_tables",
            "admin_template_hierarchy",
            "empty_error_recovery"
          ]
        }
      },
      "semantic_tokens": [
        "resource.active",
        "resource.blocked",
        "billing.warning",
        "release.pending",
        "storage.protected"
      ],
      "component_grammar": [
        {
          "name": "ResourceStatusCard",
          "figma_component": "ResourceStatusCard",
          "code_component": "ResourceStatusCard",
          "props": [
            "status",
            "title",
            "spec",
            "primaryAction",
            "receiptState"
