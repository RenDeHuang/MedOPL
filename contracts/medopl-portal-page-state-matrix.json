{
  "schema_version": 1,
  "owner": "MedOPL Portal",
  "purpose": "portal_product_page_state_matrix",
  "state": "active",
  "authority_boundary": {
    "surface": "customer_control_plane",
    "allowed_view": "platform_managed_workspace_state",
    "forbidden_view": "raw_cloud_resource_console"
  },
  "consumers": [
    "validate:active-platform",
    "tests/contracts/contract-test-v22-validate-active-platform.mjs"
  ],
  "consumer_tests": [
    "npm run validate:active-platform -- --quick --json"
  ],
  "medopl_portal_page_state_matrix": {
    "global_states": [
      "empty",
      "provisioning",
      "active",
      "degraded",
      "suspended",
      "releasing",
      "released"
    ],
    "pages": [
      {
        "id": "resource_overview",
        "owns": [
          "current_package",
          "compute_resource_status",
          "storage_space_status",
          "balance",
          "next_resource_action"
        ],
        "states": [
          "empty",
          "provisioning",
          "active",
          "suspended",
          "released"
        ]
      },
      {
        "id": "packages_purchase",
        "owns": [
          "package_plan",
          "compute_spec",
          "included_storage",
          "task_concurrency",
          "price_label",
          "purchase_action"
        ],
        "states": [
          "catalog_ready",
          "pending_price_approval",
          "purchase_blocked",
          "upgrade_available"
        ]
      },
      {
        "id": "compute_resource",
        "owns": [
          "compute_status",
          "compute_spec",
          "task_concurrency",
          "workspace_binding",
          "release_state",
          "stop_billing_state"
        ],
        "states": [
          "not_opened",
          "opening",
          "idle",
          "running",
          "failed",
          "releasing",
          "released"
        ]
      },
      {
        "id": "storage_space",
        "owns": [
          "capacity",
          "used_space",
          "workspace_binding",
          "input_file_inventory",
          "output_file_inventory",
          "retention",
          "protection_period"
        ],
        "states": [
          "empty",
          "ready",
          "quota_limited",
          "protected",
          "destroy_pending",
          "destroyed"
        ]
      },
      {
        "id": "usage_billing",
        "owns": [
          "balance",
          "freeze",
          "compute_usage",
          "storage_usage",
          "ledger",
          "invoices",
          "stop_billing_reconciliation",
          "audit_receipt"
        ],
        "states": [
          "trial",
          "funded",
          "past_due",
          "frozen"
        ]
      },
      {
        "id": "opl_entry",
        "owns": [
          "opl_entry_state",
          "compute_resource_gate",
          "storage_binding_gate",
          "provider_key_gate",
          "missing_next_step"
        ],
        "states": [
          "available",
          "blocked_by_compute",
          "blocked_by_storage",
          "blocked_by_provider_key",
          "blocked_by_balance"
        ]
      },
      {
        "id": "release",
        "owns": [
          "release_request",
          "resource_cleanup",
          "final_receipt"
        ],
        "states": [
          "eligible",
          "pending",
          "completed",
          "blocked"
        ]
      }
    ]
  }
}
