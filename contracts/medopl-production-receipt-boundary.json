{
  "schema_version": 1,
  "owner": "MedOPL Release",
  "purpose": "production_receipt_boundary_owner_receipt_aggregator",
  "state": "active",
  "authority_boundary": {
    "surface": "production_complete_owner_receipt_aggregation",
    "production_complete_requires": "complete_receipt_manifest",
    "local_rc_claim_upgrade": "forbidden",
    "cloud_deployable_rc_claim_upgrade": "forbidden",
    "authorized_cloud_command_receipt_manifest": "required",
    "receipt_manifest_storage": "runtime_pointer_summary_only"
  },
  "consumers": [
    "validate:active-platform",
    "scripts/v22-production-receipt-boundary.mjs",
    "scripts/v22-verify.mjs cloud-release-candidate",
    "scripts/v22-test-report.mjs",
    "tests/release/release-test-v22-production-receipt-boundary.mjs",
    "tests/health/health-check-v22-production-receipt-boundary.mjs"
  ],
  "consumer_tests": [
    "node tests/release/release-test-v22-production-receipt-boundary.mjs",
    "node tests/health/health-check-v22-production-receipt-boundary.mjs"
  ],
  "production_receipt_boundary": {
    "required_receipt_types": [
      "runtime_owner_receipt",
      "storage_owner_receipt",
      "billing_owner_receipt",
      "audit_owner_receipt",
      "release_owner_receipt",
      "opl_webui_consumer_receipt",
      "production_deploy_receipt"
    ],
    "production_complete_state": "complete",
    "allowed_completion_evidence_levels": [
      "production_canary",
      "production"
    ],
    "forbidden_completion_evidence_levels": [
      "local_rc",
      "cloud_deployable_rc"
    ],
    "local_rc_claim_upgrade": "forbidden",
    "cloud_deployable_rc_claim_upgrade": "forbidden",
    "authorized_command_receipt_manifest_required": true,
    "receipt_manifest_path_pattern": ".runtime/v22-cloud-authorization/**/receipt-manifest.json",
    "receipt_manifest_policy": "small_pointer_and_summary_only",
    "receipt_operation_binding_required": true,
    "receipt_authorization_ref_required": true,
    "receipt_runner_id_required": true,
    "production_complete_owner_receipt_gate": {
      "state": "fail_closed_until_dedicated_production_complete_receipt",
      "current_claimable_state": "cloud_release_candidate_only",
      "claim_upgrade_from_cloud_rc": "forbidden",
      "production_complete_criteria_manifest_field": "production_complete_criteria",
      "criteria_evidence_ref_policy": "runtime_pointer_summary_only",
      "criteria_evidence_hash_policy": "sha256_pointer_hash_required",
      "scope_policy": {
        "default_claim_scope": "current_authorized_canary_path_only",
        "scope_expansion_requires": "dedicated_contract_and_evidence",
        "single_canary_upgrade": "forbidden"
      },
      "required_gates": [
        "release_owner_receipt",
        "security_dependency_gate",
        "browser_accessibility_regression",
        "role_boundary_browser_gate",
        "s_level_ui_polish_gate",
        "observability_receipt"
      ],
      "required_operational_criteria": [
        "release_owner_readiness_receipt",
        "production_dependency_security_receipt",
        "browser_accessibility_verification_receipt",
        "s_level_ui_polish_receipt",
        "observability_deploy_receipt",
        "rollback_readiness_receipt",
        "post_release_monitoring_receipt"
      ],
      "explicit_non_goals_until_dedicated_contract": [
        "multi_region_production",
        "sla_proven",
        "enterprise_compliance",
        "ongoing_authorization",
        "unobserved_tenants_or_resources"
      ]
    },
    "lifecycle_section_evidence_hash_policy": "sha256_pointer_hash_required",
    "forbidden_raw_manifest_fields": [
      "raw_cloud_payload",
      "raw_payload",
      "provider_response",
      "provider_payload",
      "kubeconfig",
      "secret",
      "token",
      "logs",
      "log",
      "screenshots",
      "screenshot",
      "uploaded_files",
      "uploaded_file",
      "upload_file",
      "artifacts",
      "artifact"
    ],
    "cloud_release_candidate_requires": "complete_lifecycle_sections_and_owner_receipts",
    "required_lifecycle_sections": [
      "authorization",
      "provider_inventory",
      "provision_plan",
      "mutation",
      "data_plane",
      "runtime_execution",
      "artifact",
      "billing",
      "audit",
      "cleanup",
      "post_destroy_inventory",
      "consumer_canary"
    ],
    "lifecycle_section_policy": "small_redacted_pointer_hash_status_only"
  }
}
