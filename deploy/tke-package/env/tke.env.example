NAMESPACE=portal-staging
RUNTIME_NAMESPACE=portal-runtime-staging
INGRESS_CLASS=nginx
TLS_SECRET_NAME=portal-tls
PORTAL_HOST=portal.example.com
OPL_HOST=opl.example.com

# Private registry pull secret already created in both namespaces.
IMAGE_PULL_SECRET=tcr-pull-secret

# Images pushed to TCR/Harbor.
PORTAL_IMAGE=ccr.ccs.tencentyun.com/your-namespace/portal:opl-v1
OPL_ADAPTER_IMAGE=ccr.ccs.tencentyun.com/your-namespace/portal-opl-adapter:opl-v1
OPL_WEB_GATEWAY_IMAGE=ccr.ccs.tencentyun.com/your-namespace/opl-web-gateway:opl-v1
OPL_WEB_IMAGE=ccr.ccs.tencentyun.com/your-namespace/opl-web:opl-v1
BILLING_IMAGE=ccr.ccs.tencentyun.com/your-namespace/billing-aggregator:opl-v1
RUNNER_ORCHESTRATOR_IMAGE=ccr.ccs.tencentyun.com/your-namespace/med-autoscience-runner-orchestrator:opl-v1
MED_AUTOSCIENCE_RUNNER_IMAGE=ccr.ccs.tencentyun.com/your-namespace/med-autoscience-runner:opl-v1

# Workload resources.
PORTAL_CPU_REQUEST=100m
PORTAL_CPU_LIMIT=400m
PORTAL_MEMORY_REQUEST=192Mi
PORTAL_MEMORY_LIMIT=384Mi

OPL_ADAPTER_CPU_REQUEST=100m
OPL_ADAPTER_CPU_LIMIT=400m
OPL_ADAPTER_MEMORY_REQUEST=192Mi
OPL_ADAPTER_MEMORY_LIMIT=384Mi

OPL_WEB_GATEWAY_CPU_REQUEST=50m
OPL_WEB_GATEWAY_CPU_LIMIT=200m
OPL_WEB_GATEWAY_MEMORY_REQUEST=64Mi
OPL_WEB_GATEWAY_MEMORY_LIMIT=128Mi

OPL_WEB_CPU_REQUEST=200m
OPL_WEB_CPU_LIMIT=600m
OPL_WEB_MEMORY_REQUEST=256Mi
OPL_WEB_MEMORY_LIMIT=512Mi

BILLING_CPU_REQUEST=50m
BILLING_CPU_LIMIT=150m
BILLING_MEMORY_REQUEST=64Mi
BILLING_MEMORY_LIMIT=128Mi

RUNNER_ORCHESTRATOR_CPU_REQUEST=100m
RUNNER_ORCHESTRATOR_CPU_LIMIT=250m
RUNNER_ORCHESTRATOR_MEMORY_REQUEST=128Mi
RUNNER_ORCHESTRATOR_MEMORY_LIMIT=256Mi

# Storage / state.
RUNTIME_STORAGE_CLASS=cfs
RUNTIME_STORAGE_SIZE=20Gi
PORTAL_STORAGE_MODE=json
PORTAL_DB_NAMESPACE=portal
PORTAL_POSTGRES_URL=postgres://user:password@postgres.example.internal:5432/portal
PORTAL_REDIS_URL=redis://redis.example.internal:6379

# Portal auth / secrets.
PORTAL_ADMIN_EMAIL=admin@example.com
PORTAL_ADMIN_PASSWORD=replace-me
PORTAL_OIDC_ENABLED=0
PORTAL_IDENTITY_SYNC_MODE=local
PORTAL_OIDC_ISSUER=
PORTAL_OIDC_CLIENT_ID=
PORTAL_OIDC_CLIENT_SECRET=
OPL_LAUNCH_SECRET=replace-with-long-random-secret

# OPL runtime.
OPL_RUNTIME_MODE=acp
OPL_ACP_RUNTIME_DIR=
OPL_ACP_RUNTIME_COMMAND_JSON=
OPL_ACP_RUNTIME_TIMEOUT_MS=30000
OPL_WEB_UPSTREAM_URL=http://opl-web-upstream:3000
OPL_WEBUI_AUTH_MODE=none

# Billing / cost.
OPENCOST_BASE_URL=
OPENCOST_UI_URL=

# Storage and registry integrations.
MINIO_API_URL=
MINIO_CONSOLE_URL=
HARBOR_URL=
HARBOR_API_URL=
HARBOR_ENABLED=0
HARBOR_USERNAME=
HARBOR_PASSWORD=

# Trace.
LANGFUSE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

MED_AUTOSCIENCE_RUNNER_TOKEN=
MED_AUTOSCIENCE_RUNNER_COMMAND=medautosci show-agent-entry-modes
MED_AUTOSCIENCE_RUNNER_CPU_REQUEST=100m
MED_AUTOSCIENCE_RUNNER_CPU_LIMIT=500m
MED_AUTOSCIENCE_RUNNER_MEMORY_REQUEST=256Mi
MED_AUTOSCIENCE_RUNNER_MEMORY_LIMIT=512Mi
