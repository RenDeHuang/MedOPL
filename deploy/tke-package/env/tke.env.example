NAMESPACE=portal-staging
RUNTIME_NAMESPACE=portal-runtime-staging
RUNNER_RBAC_NAME=med-autoscience-runner-job-manager-staging
INGRESS_CLASS=nginx
TLS_SECRET_NAME=portal-tls
PORTAL_HOST=portal.example.com
OPL_HOST=opl.example.com
BASE_DOMAIN=example.com
TRACE_TLS_SECRET_NAME=trace-tls
BUILD_SHA=opl-v20
BUILD_TIME=2026-05-03T00:00:00Z
PRODUCT_RUNTIME_MODE=user_owned
PRODUCT_OPS_PROFILE=0

# Private registry pull secret already created in both namespaces.
IMAGE_PULL_SECRET=gaofeng-tcr-key
IMAGE_PULL_POLICY=Always

# Images pushed to TCR/Harbor.
PORTAL_IMAGE=ccr.ccs.tencentyun.com/your-namespace/portal:opl-v13
OPL_ADAPTER_IMAGE=ccr.ccs.tencentyun.com/your-namespace/portal-opl-adapter:opl-v13
OPL_WEB_GATEWAY_IMAGE=ccr.ccs.tencentyun.com/your-namespace/opl-web-gateway:opl-v13
OPL_WEB_IMAGE=ccr.ccs.tencentyun.com/your-namespace/opl-web:opl-v1
BILLING_IMAGE=ccr.ccs.tencentyun.com/your-namespace/billing-aggregator:opl-v13
RESOURCE_PROVISIONER_IMAGE=ccr.ccs.tencentyun.com/your-namespace/resource-provisioner:opl-v13
RUNNER_ORCHESTRATOR_IMAGE=ccr.ccs.tencentyun.com/your-namespace/med-autoscience-runner-orchestrator:opl-v13
MED_AUTOSCIENCE_RUNNER_IMAGE=ccr.ccs.tencentyun.com/your-namespace/med-autoscience-runner:opl-v1

# Workload resources.
PORTAL_CPU_REQUEST=100m
PORTAL_CPU_LIMIT=400m
PORTAL_MEMORY_REQUEST=192Mi
PORTAL_MEMORY_LIMIT=384Mi

OPL_ADAPTER_CPU_REQUEST=100m
OPL_ADAPTER_CPU_LIMIT=400m
OPL_ADAPTER_MEMORY_REQUEST=192Mi
OPL_ADAPTER_MEMORY_LIMIT=384Mi

OPL_WEB_GATEWAY_CPU_REQUEST=50m
OPL_WEB_GATEWAY_CPU_LIMIT=200m
OPL_WEB_GATEWAY_MEMORY_REQUEST=64Mi
OPL_WEB_GATEWAY_MEMORY_LIMIT=128Mi

OPL_WEB_CPU_REQUEST=200m
OPL_WEB_CPU_LIMIT=600m
OPL_WEB_MEMORY_REQUEST=256Mi
OPL_WEB_MEMORY_LIMIT=1Gi

BILLING_CPU_REQUEST=50m
BILLING_CPU_LIMIT=150m
BILLING_MEMORY_REQUEST=64Mi
BILLING_MEMORY_LIMIT=128Mi

RESOURCE_PROVISIONER_CPU_REQUEST=50m
RESOURCE_PROVISIONER_CPU_LIMIT=150m
RESOURCE_PROVISIONER_MEMORY_REQUEST=64Mi
RESOURCE_PROVISIONER_MEMORY_LIMIT=128Mi

RUNNER_ORCHESTRATOR_CPU_REQUEST=100m
RUNNER_ORCHESTRATOR_CPU_LIMIT=250m
RUNNER_ORCHESTRATOR_MEMORY_REQUEST=128Mi
RUNNER_ORCHESTRATOR_MEMORY_LIMIT=256Mi

# Storage / state.
RUNTIME_STORAGE_CLASS=cfs
RUNTIME_STORAGE_SIZE=20Gi
PORTAL_STORAGE_MODE=json
PORTAL_DB_NAMESPACE=portal
PORTAL_POSTGRES_URL=postgres://user:password@postgres.example.internal:5432/portal
PORTAL_REDIS_URL=redis://redis.example.internal:6379

# Portal auth / secrets.
PORTAL_ADMIN_EMAIL=admin@example.com
PORTAL_ADMIN_NAME=Admin
PORTAL_ADMIN_PASSWORD=replace-me
PORTAL_INTERNAL_AUTH_TOKEN=replace-with-long-random-secret
PORTAL_OIDC_ENABLED=0
PORTAL_IDENTITY_SYNC_MODE=local
PORTAL_OIDC_ISSUER=
PORTAL_OIDC_CLIENT_ID=
PORTAL_OIDC_CLIENT_SECRET=
OPL_LAUNCH_SECRET=replace-with-long-random-secret

# OPL runtime.
OPL_RUNTIME_MODE=acp
OPL_ACP_RUNTIME_DIR=/app/one-person-lab-upstream
OPL_ACP_RUNTIME_COMMAND_JSON=
OPL_ACP_RUNTIME_TIMEOUT_MS=120000
OPL_WEB_UPSTREAM_URL=http://opl-web-upstream:3000
OPL_WEBUI_AUTH_MODE=none

# Billing / cost.
OPENCOST_BASE_URL=
OPENCOST_UI_URL=
TENCENT_BILLING_ENABLED=0
TENCENT_BILLING_REQUIRED=0
TENCENT_PRICE_ENABLED=0
TENCENT_CLOUD_REGION=na-siliconvalley
TENCENT_PRICE_IMAGE_ID=img-487zeit5
TENCENT_PLAN_DISCOVERY_ENABLED=0
TENCENT_PLAN_DISCOVERY_ZONES=
TENCENT_PLAN_DISCOVERY_CHARGE_TYPE=POSTPAID_BY_HOUR
TENCENT_PLAN_DISCOVERY_MAX=80
SERVER_PLAN_CATALOG_JSON=[]
RESOURCE_PROVISIONING_ENABLED=0
TENCENT_TKE_ENDPOINT=tke.intl.tencentcloudapi.com
TENCENT_TKE_VERSION=2018-05-25
TENCENT_TKE_CLUSTER_ID=cls-ngiq693i
TENCENT_TKE_ZONE=na-siliconvalley-1
TENCENT_VPC_ID=vpc-ahl6epyx
TENCENT_SUBNET_IDS=subnet-mbehh5wi,subnet-r8mzuptu
TENCENT_SECURITY_GROUP_ID=sg-6671l5we
TENCENT_TKE_NODE_IMAGE_ID=img-487zeit5
TENCENT_COS_BILL_BUCKET=opl-1410708315
TENCENT_COS_BILL_REGION=na-siliconvalley
TENCENT_COS_BILL_PREFIX=daily/
TENCENT_COS_BILL_ENDPOINT=https://opl-1410708315.cos.na-siliconvalley.myqcloud.com
TENCENT_BILLING_SECRET_ID=
TENCENT_BILLING_SECRET_KEY=
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_CLOUD_TOKEN=
BILLING_RECONCILE_SCHEDULE=*/30 * * * *

# Storage and registry integrations.
MINIO_API_URL=
MINIO_CONSOLE_URL=
HARBOR_URL=
HARBOR_API_URL=
HARBOR_ENABLED=0
HARBOR_USERNAME=
HARBOR_PASSWORD=

# Trace.
LANGFUSE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PROJECT_ID=
LANGFUSE_STORAGE_CLASS=standard
LANGFUSE_NEXTAUTH_SECRET=replace-with-k8s-secret
LANGFUSE_SALT=replace-with-k8s-secret
LANGFUSE_ENCRYPTION_KEY=replace-with-64-hex-k8s-secret
LANGFUSE_POSTGRES_PASSWORD=replace-with-k8s-secret
LANGFUSE_DATABASE_URL=postgresql://postgres:replace-with-k8s-secret@langfuse-postgres:5432/langfuse
LANGFUSE_CLICKHOUSE_PASSWORD=replace-with-k8s-secret
LANGFUSE_INIT_USER_PASSWORD=replace-with-k8s-secret

MED_AUTOSCIENCE_RUNNER_TOKEN=
MED_AUTOSCIENCE_RUNNER_COMMAND=medautosci show-agent-entry-modes
MED_AUTOSCIENCE_RUNNER_CPU_REQUEST=100m
MED_AUTOSCIENCE_RUNNER_CPU_LIMIT=500m
MED_AUTOSCIENCE_RUNNER_MEMORY_REQUEST=256Mi
MED_AUTOSCIENCE_RUNNER_MEMORY_LIMIT=512Mi
