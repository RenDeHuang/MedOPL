{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "medopl",
        "labels": {
          "app.kubernetes.io/name": "medopl"
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "medopl-control-plane",
        "namespace": "medopl",
        "labels": {
          "app.kubernetes.io/name": "medopl"
        }
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "medopl"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "medopl"
            }
          },
          "spec": {
            "imagePullSecrets": [
              {
                "name": "tcr-pull-secret"
              }
            ],
            "nodeSelector": {
              "medopl.cn/workload": "medopl"
            },
            "containers": [
              {
                "name": "control-plane",
                "image": "uswccr.ccs.tencentyun.com/medopl/medopl-go-backend:placeholder",
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080
                  }
                ],
                "env": [
                  {
                    "name": "MEDOPL_ENV",
                    "value": "production"
                  },
                  {
                    "name": "MEDOPL_PUBLIC_BASE_URL",
                    "value": "https://portal.medopl.cn"
                  },
                  {
                    "name": "OPL_WEBUI_PUBLIC_BASE_URL",
                    "value": "https://opl.medopl.cn"
                  },
                  {
                    "name": "DATABASE_URL",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "medopl-postgres",
                        "key": "DATABASE_URL"
                      }
                    }
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/readyz",
                    "port": 8080
                  }
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": 8080
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "512Mi"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "medopl-control-plane",
        "namespace": "medopl"
      },
      "spec": {
        "type": "NodePort",
        "selector": {
          "app.kubernetes.io/name": "medopl"
        },
        "ports": [
          {
            "name": "http",
            "port": 8080,
            "targetPort": 8080
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "Ingress",
      "metadata": {
        "name": "medopl",
        "namespace": "medopl"
      },
      "spec": {
        "ingressClassName": "qcloud",
        "tls": [
          {
            "hosts": [
              "portal.medopl.cn"
            ],
            "secretName": "medopl-tls"
          }
        ],
        "rules": [
          {
            "host": "portal.medopl.cn",
            "http": {
              "paths": [
                {
                  "path": "/",
                  "pathType": "Prefix",
                  "backend": {
                    "service": {
                      "name": "medopl-control-plane",
                      "port": {
                        "number": 8080
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
