{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "medopl",
        "labels": {
          "app.kubernetes.io/name": "medopl"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "medopl-control-plane",
        "namespace": "medopl",
        "labels": {
          "app.kubernetes.io/name": "medopl"
        }
      },
      "automountServiceAccountToken": false
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "medopl-control-plane",
        "namespace": "medopl",
        "labels": {
          "app.kubernetes.io/name": "medopl"
        }
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "medopl"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "medopl"
            }
          },
          "spec": {
            "serviceAccountName": "medopl-control-plane",
            "automountServiceAccountToken": false,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "runAsGroup": 10001,
              "fsGroup": 10001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "imagePullSecrets": [
              {
                "name": "tcr-pull-secret"
              }
            ],
            "nodeSelector": {
              "medopl.cn/workload": "medopl"
            },
            "containers": [
              {
                "name": "control-plane",
                "image": "uswccr.ccs.tencentyun.com/medopl/medopl-go-backend:placeholder",
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080
                  }
                ],
                "env": [
                  {
                    "name": "MEDOPL_ENV",
                    "value": "production"
                  },
                  {
                    "name": "MEDOPL_PUBLIC_BASE_URL",
                    "value": "https://portal.medopl.cn"
                  },
                  {
                    "name": "OPL_WEBUI_PUBLIC_BASE_URL",
                    "value": "https://opl.medopl.cn"
                  },
                  {
                    "name": "PORTAL_OPL_PROVIDER_SECRET_ROOT",
                    "value": "/tmp/medopl-runtime/provider-secrets"
                  },
                  {
                    "name": "MEDOPL_PORTAL_STATIC_ROOT",
                    "value": "/app/portal"
                  },
                  {
                    "name": "DATABASE_URL",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "medopl-postgres",
                        "key": "DATABASE_URL"
                      }
                    }
                  },
                  {
                    "name": "MEDOPL_AUTH_TOKEN_SHA256",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "medopl-auth-boundary",
                        "key": "MEDOPL_AUTH_TOKEN_SHA256"
                      }
                    }
                  },
                  {
                    "name": "MEDOPL_ADMIN_TOKEN_SHA256",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "medopl-auth-boundary",
                        "key": "MEDOPL_ADMIN_TOKEN_SHA256"
                      }
                    }
                  },
                  {
                    "name": "MEDOPL_WEBHOOK_SECRET_SHA256",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "medopl-auth-boundary",
                        "key": "MEDOPL_WEBHOOK_SECRET_SHA256"
                      }
                    }
                  },
                  {
                    "name": "MEDOPL_SESSION_SIGNING_SECRET_SHA256",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "medopl-auth-boundary",
                        "key": "MEDOPL_SESSION_SIGNING_SECRET_SHA256"
                      }
                    }
                  },
                  {
                    "name": "MEDOPL_SESSION_BOOTSTRAP_SECRET_SHA256",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "medopl-auth-boundary",
                        "key": "MEDOPL_SESSION_BOOTSTRAP_SECRET_SHA256"
                      }
                    }
                  },
                  {
                    "name": "MEDOPL_CANARY_ADMISSION_ENABLED",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "medopl-canary-admission",
                        "key": "MEDOPL_CANARY_ADMISSION_ENABLED",
                        "optional": true
                      }
                    }
                  },
                  {
                    "name": "MEDOPL_CANARY_EMERGENCY_STOP",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "medopl-canary-admission",
                        "key": "MEDOPL_CANARY_EMERGENCY_STOP",
                        "optional": true
                      }
                    }
                  },
                  {
                    "name": "MEDOPL_CANARY_TENANT_ALLOWLIST",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "medopl-canary-admission",
                        "key": "MEDOPL_CANARY_TENANT_ALLOWLIST",
                        "optional": true
                      }
                    }
                  },
                  {
                    "name": "MEDOPL_CANARY_USER_ALLOWLIST",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "medopl-canary-admission",
                        "key": "MEDOPL_CANARY_USER_ALLOWLIST",
                        "optional": true
                      }
                    }
                  },
                  {
                    "name": "MEDOPL_CANARY_COST_CEILING_USD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "medopl-canary-admission",
                        "key": "MEDOPL_CANARY_COST_CEILING_USD",
                        "optional": true
                      }
                    }
                  },
                  {
                    "name": "MEDOPL_CANARY_ADMISSION_ENABLED_BY",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "medopl-canary-admission",
                        "key": "MEDOPL_CANARY_ADMISSION_ENABLED_BY",
                        "optional": true
                      }
                    }
                  },
                  {
                    "name": "MEDOPL_CANARY_MONITORING_OWNER",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "medopl-canary-admission",
                        "key": "MEDOPL_CANARY_MONITORING_OWNER",
                        "optional": true
                      }
                    }
                  },
                  {
                    "name": "MEDOPL_CANARY_ROLLBACK_OWNER",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "medopl-canary-admission",
                        "key": "MEDOPL_CANARY_ROLLBACK_OWNER",
                        "optional": true
                      }
                    }
                  },
                  {
                    "name": "MEDOPL_CANARY_DISABLE_COMMAND_REF",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "medopl-canary-admission",
                        "key": "MEDOPL_CANARY_DISABLE_COMMAND_REF",
                        "optional": true
                      }
                    }
                  }
                ],
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/readyz",
                    "port": 8080
                  }
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": 8080
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "512Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "medopl-runtime-state",
                    "mountPath": "/tmp/medopl-runtime"
                  },
                  {
                    "name": "medopl-tmp",
                    "mountPath": "/tmp"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "medopl-runtime-state",
                "emptyDir": {}
              },
              {
                "name": "medopl-tmp",
                "emptyDir": {}
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "medopl-control-plane",
        "namespace": "medopl"
      },
      "spec": {
        "type": "NodePort",
        "selector": {
          "app.kubernetes.io/name": "medopl"
        },
        "ports": [
          {
            "name": "http",
            "port": 8080,
            "targetPort": 8080
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "medopl-control-plane-ingress",
        "namespace": "medopl",
        "labels": {
          "app.kubernetes.io/name": "medopl"
        }
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app.kubernetes.io/name": "medopl"
          }
        },
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "ports": [
              {
                "protocol": "TCP",
                "port": 8080
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "Ingress",
      "metadata": {
        "name": "medopl",
        "namespace": "medopl",
        "annotations": {
          "ingress.cloud.tencent.com/listen-ports": "[{\"HTTP\":80},{\"HTTPS\":443}]",
          "ingress.cloud.tencent.com/auto-rewrite": "true",
          "ingress.cloud.tencent.com/rewrite-support": "true"
        }
      },
      "spec": {
        "ingressClassName": "qcloud",
        "tls": [
          {
            "hosts": [
              "portal.medopl.cn"
            ],
            "secretName": "medopl-tls"
          }
        ],
        "rules": [
          {
            "host": "portal.medopl.cn",
            "http": {
              "paths": [
                {
                  "path": "/",
                  "pathType": "Prefix",
                  "backend": {
                    "service": {
                      "name": "medopl-control-plane",
                      "port": {
                        "number": 8080
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
