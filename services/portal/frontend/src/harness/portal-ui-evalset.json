  "pageTasks": [
    {
      "routeId": "overview",
      "task": "回答用户能不能工作、余额是否足够、任务和托管环境是否正常、从哪里进入 OPL 工作台",
      "status": "done"
    },
    {
      "routeId": "resources",
      "task": "回答当前套餐、计算规格、文件空间、并发数、预计费用和冻结金额状态",
      "status": "done"
    },
    {
      "routeId": "trace",
      "task": "回答最近任务状态、输出位置、资源用量和费用估算",
      "status": "done"
    },
    {
      "routeId": "workspace",
      "task": "回答工作空间文件夹、输入文件、输出文件、保护期和下载入口",
      "status": "done"
    },
    {
      "routeId": "billing",
      "task": "回答余额、可用余额、冻结金额、累计消费、今日消费、账户流水、充值记录和退款记录",
      "status": "done"
    },
    {
      "routeId": "admin.system",
      "task": "回答站点设置和服务状态当前是什么状态",
      "status": "done"
    },
    {
      "routeId": "admin.dashboard",
      "task": "回答平台今日用户、工作空间、任务、消费、待处理事项和管理入口是否正常",
      "status": "done"
    },
    {
      "routeId": "admin.users",
      "task": "回答客户账户数量、注册状态、余额、账户状态以及充值退款入口",
      "status": "done"
    },
    {
      "routeId": "admin.billing_ops",
      "task": "回答账单对账、待补记录、成本构成和最近调整状态",
      "status": "done"
    },
    {
      "routeId": "admin.usage",
      "task": "回答任务记录、运行状态、成本和下钻入口",
      "status": "done"
    },
    {
      "routeId": "admin.audit",
      "task": "回答审计记录、事件来源、操作人和工作空间归属",
      "status": "done"
    }
  ],
