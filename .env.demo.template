# MedOPL v22 local default-entry template.
# Tracked template only: keep secret, token, password, and key values empty.
# Default entry is Portal -> OPL Web Gateway -> Runtime Bridge / Adapter -> clean One Person Lab upstream.

# Portal local shell.
PORT=17080
PORTAL_PUBLIC_URL=http://127.0.0.1:17080
PORTAL_STORAGE_MODE=json
PORTAL_RUNTIME_ROOT=
PORTAL_IDENTITY_SYNC_MODE=local
PORTAL_OIDC_ENABLED=0
PORTAL_ADMIN_EMAIL=admin@medopl.local
PORTAL_ADMIN_NAME=MedOPL Admin
PORTAL_ADMIN_PASSWORD=
PORTAL_ADMIN_SEED_BALANCE=100
PORTAL_INTERNAL_AUTH_TOKEN=

# Portal -> Runtime Bridge adapter.
PORTAL_OPL_ADAPTER_URL=http://127.0.0.1:8788
PORTAL_OPL_ADAPTER_PUBLIC_URL=http://127.0.0.1:8788
PORTAL_OPL_ADAPTER_STATE_ROOT=
PORTAL_INTERNAL_BASE_URL=http://127.0.0.1:17080

# OPL Web Gateway and clean upstream OPL Web.
OPL_WEB_URL=http://127.0.0.1:13031
OPL_WEB_GATEWAY_ENABLED=1
OPL_WEB_GATEWAY_PORT=13031
OPL_WEB_GATEWAY_PUBLIC_URL=http://127.0.0.1:13031
OPL_WEB_UPSTREAM_URL=http://127.0.0.1:13030
OPL_WEB_START_MODE=local
OPL_WEB_REUSE=1
OPL_WEB_BUILD_LOCAL=1
OPL_WEB_PORT=13030

# Runtime Bridge local contract mode.
PRODUCT_RUNTIME_MODE=platform_provisioned
OPL_RUNTIME_MODE=acp
OPL_ACP_RUNTIME_DIR=
OPL_ACP_RUNTIME_COMMAND_JSON=
OPL_ACP_RUNTIME_TIMEOUT_MS=15000
OPL_RUNTIME_TIMEOUT_MS=10000
OPL_PRODUCT_API_URL=
OPL_PRODUCT_API_TOKEN=
OPL_DEFAULT_PROJECT_ID=medautoscience
OPL_DEFAULT_WORKSPACE_PATH=
OPL_WORKSPACE_ROOT=
OPL_WORKSPACE_ENTRY_COMMAND=
OPL_WORKSPACE_MANIFEST_COMMAND=
OPL_WORKSPACE_ENTRY_URL=
OPL_WORKSPACE_PROFILE_REF=
OPL_LAUNCH_SECRET=

# Portal billing local template. OpenCost is not billing truth in this template.
BILLING_SERVICE_URL=

# Langfuse is optional sanitized trace attachment only; keep disabled unless explicitly wired.
LANGFUSE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PROJECT_ID=
