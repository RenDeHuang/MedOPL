{
  "schema_version": 1,
  "mode": "autonomous_goal_runner",
  "entrypoint": "node scripts/v22-verify.mjs current --base origin/recovery/platform-v22-trunk",
  "truth_sources": [
    "docs/recovery/v22-goal-current.json",
    "docs/recovery/v22-agent-verify-manifest.json"
  ],
  "auto_run_allowed_risk_classes": [
    "local_doc_eval"
  ],
  "auto_review_allowed_risk_classes": [
    "local_doc_eval"
  ],
  "manual_stop_risk_classes": [
    "sensitive_boundary",
    "live_external"
  ],
  "forbidden_ops_always_stop": [
    "secret",
    "live-cloud",
    "true-cloud-mutation",
    "build-push-kubectl",
    "deploy",
    "live-test",
    "upstream-write",
    "dependency-upgrade"
  ],
  "max_leafs_per_session": 3,
  "requires_branch_per_leaf": true,
  "requires_b_absorb_before_next_leaf": true,
  "cursor_advancement_source": "post_absorb_trunk_only",
  "receipt_path": ".runtime/v22-autonomous-goal-runner/",
  "failure_categories": [
    "contract_wrong",
    "eval_wrong",
    "implementation_wrong",
    "authorization_missing",
    "problem_should_split"
  ]
}
